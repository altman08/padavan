+        super::super::selftest(&mut t, &[7; 32]).unwrap();
+        let input = vec![29; 16384];
+        let allocation = t.buffer.data().as_ptr();
+        for n in [16384, 8192, MAX, 8193, 8192] {
+            let input = vec![29; n];
+            let encrypted = t.exchange(&[19; 12], &input, b"aad", false).unwrap();
+            let plain = t.exchange(&[19; 12], &encrypted, b"aad", true).unwrap();
+            assert_eq!(*plain, input);
+            assert!(t.buffer.data().iter().all(|b| *b == 0));
+            assert_eq!(t.buffer.data().as_ptr(), allocation);
+            assert!(t.aad.data().iter().all(|b| *b == 0));
+            assert!(t.iv.data().iter().all(|b| *b == 0));
+        }
+        drop(t);
+        assert!(Devcrypto::open_with(&[7; 32], c"/dev/null", bad_driver).is_err());
+        let mut t = Devcrypto::open_with(&[7; 32], c"/dev/null", auth_error).unwrap();
+        let err = t.exchange(&[19; 12], &input, b"aad", true).unwrap_err();
+        assert_eq!(err.raw_os_error(), Some(libc::EBADMSG));
+        assert_eq!(input, vec![29; 16384]);
+        assert!(t.buffer.data().iter().all(|b| *b == 0));
+        drop(t);
+        let mut t = Devcrypto::open_with(&[7; 32], c"/dev/null", short_output).unwrap();
+        assert!(t.exchange(&[19; 12], &input, b"aad", false).is_err());
+        drop(t);
+        CLOSED.with(|n| assert_eq!(n.get(), 4));
+    }
