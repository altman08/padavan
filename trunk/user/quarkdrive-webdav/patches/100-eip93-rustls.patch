+#[test]
+#[ignore = "requires Linux AF_ALG gcm_base(ctr(aes-generic),ghash-generic)"]
+#[cfg(all(
+    target_os = "linux",
+    target_pointer_width = "64",
+    target_endian = "little",
+    any(target_arch = "aarch64", target_arch = "x86_64")
+))]
+fn kernel_afalg_tls_interoperability() {
+    // Fail instead of silently passing via software when the kernel path is unavailable.
+    for key in [vec![7; 16], vec![7; 32]] {
+        let mut t = generic_open(Backend::Afalg, &key).unwrap();
+        selftest(t.as_mut(), &key).unwrap();
+    }
+    std::thread::scope(|scope| {
+        for worker in 0..8 {
+            scope.spawn(move || {
+                let key = vec![worker + 1; 32];
+                let mut t = generic_open(Backend::Afalg, &key).unwrap();
+                selftest(t.as_mut(), &key).unwrap();
+                for sequence in 0..20 {
+                    let nonce = [sequence; 12];
+                    let plain = vec![worker; 16384];
+                    let out = t.exchange(&nonce, &plain, b"aad", false).unwrap();
+                    assert_eq!(*t.exchange(&nonce, &out, b"aad", true).unwrap(), plain);
+                    let mut corrupt = out.to_vec(); *corrupt.last_mut().unwrap() ^= 1;
+                    assert!(matches!(t.exchange(&nonce, &corrupt, b"aad", true), Err(e) if e.raw_os_error() == Some(libc::EBADMSG)));
+                    assert!(t.exchange(&[sequence ^ 0x80; 12], &out, b"aad", true).is_err());
+                    assert!(t.exchange(&nonce, &out, b"bad", true).is_err());
+                    assert_eq!(*t.exchange(&nonce, &out, b"aad", true).unwrap(), plain);
+                }
+            });
+        }
+    });
+    let before = KERNEL_DATA_CALLS.load(Ordering::Relaxed);
+    interop(generic_open);
+    assert!(KERNEL_DATA_CALLS.load(Ordering::Relaxed) > before + 50);
+}
