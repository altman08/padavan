+#[test]
+fn tls_runtime_failure_preserves_input_for_software_fallback() {
+    struct FailAfterSelftest {
+        inner: SoftwareTransport,
+        count: usize,
+    }
+    impl Transport for FailAfterSelftest {
+        fn exchange_into(
+            &mut self,
+            nonce: &[u8; 12],
+            src: &[u8],
+            aad: &[u8],
+            decrypt: bool,
+            dst: &mut [u8],
+        ) -> io::Result<usize> {
+            self.count += 1;
+            if self.count > 3 {
+                return Err(io::Error::from_raw_os_error(libc::EIO));
+            }
+            self.inner.exchange_into(nonce, src, aad, decrypt, dst)
+        }
+    }
+    fn fail(_: Backend, key: &[u8]) -> io::Result<Box<dyn Transport>> {
+        Ok(Box::new(FailAfterSelftest {
+            inner: software(key),
+            count: 0,
+        }))
+    }
+    interop(fail);
+}
