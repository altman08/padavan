+const MIN: usize = 8192;
+const MAX: usize = 32768;
+const TAG: usize = 16;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Backend {
+    Auto,
+    Devcrypto,
+    Afalg,
+    Off,
+}
+impl Backend {
+    fn parse(value: &str) -> Self {
+        match value {
+            "" | "auto" => Self::Auto,
+            "devcrypto" => Self::Devcrypto,
+            "afalg" => Self::Afalg,
+            "off" => Self::Off,
+            _ => {
+                tracing::warn!("Unknown QUARK_EIP93 value; acceleration disabled");
+                Self::Off
+            }
+        }
+    }
+}
+
+// exchange_into keeps input untouched and copies output only after authentication.
+trait Transport: Send + Sync {
+    fn exchange_into(
+        &mut self,
+        nonce: &[u8; 12],
+        src: &[u8],
+        aad: &[u8],
+        decrypt: bool,
+        dst: &mut [u8],
+    ) -> io::Result<usize>;
+    #[cfg(test)]
+    fn exchange(
+        &mut self,
+        nonce: &[u8; 12],
+        src: &[u8],
+        aad: &[u8],
+        decrypt: bool,
+    ) -> io::Result<Zeroizing<Vec<u8>>> {
+        let mut out = Zeroizing::new(vec![0; src.len() + TAG]);
+        let n = self.exchange_into(nonce, src, aad, decrypt, &mut out)?;
+        out[n..].zeroize();
+        out.truncate(n);
+        Ok(out)
+    }
+}
+// Reuse live buffers, clearing only bytes used by this record. Zeroizing also
+// clears their full allocation when the key/session is released.
+#[inline(never)]
+fn wipe(bytes: &mut [u8]) {
+    bytes.fill(0);
+    std::hint::black_box(bytes);
+}
+fn output_len(src: &[u8], aad: &[u8], decrypt: bool, dst: &[u8]) -> io::Result<usize> {
+    let n = if decrypt {
+        src.len().checked_sub(TAG)
+    } else {
+        Some(src.len())
+    }
+    .ok_or(io::ErrorKind::InvalidInput)?;
+    let expected = if decrypt { n } else { n + TAG };
+    if n > MAX || aad.len() > 256 || dst.len() < expected {
+        return Err(io::ErrorKind::InvalidInput.into());
+    }
+    Ok(expected)
+}
+struct Record<'a>(&'a mut [u8]);
+impl std::ops::Deref for Record<'_> {
+    type Target = [u8];
+    fn deref(&self) -> &[u8] {
+        self.0
+    }
+}
+impl Drop for Record<'_> {
+    fn drop(&mut self) {
+        wipe(self.0);
+    }
+}
+type Open = fn(Backend, &[u8]) -> io::Result<Box<dyn Transport>>;
+#[derive(Clone, Copy)]
+struct Settings {
+    backend: Backend,
+    open: Open,
+}
+
+fn compatible(data: &[u8]) -> bool {
+    if data.last() != Some(&0) {
+        return false;
+    }
+    let mut found = false;
+    for part in data.split(|b| *b == 0) {
+        match part {
+            b"airoha,an7583" | b"airoha,en7583" => return false,
+            b"airoha,an7581" | b"airoha,en7581" => found = true,
+            _ => (),
+        }
+    }
+    found
+}
+
+fn supported_device() -> bool {
+    #[cfg(all(target_os = "linux", target_arch = "aarch64", target_endian = "little"))]
+    {
+        if std::arch::is_aarch64_feature_detected!("aes") {
+            return false;
+        }
+        for path in [
+            "/sys/firmware/devicetree/base/compatible",
+            "/proc/device-tree/compatible",
+        ] {
+            if let Ok(data) = std::fs::read(path) {
+                return compatible(&data);
+            }
+        }
+    }
+    false
+}
+
+fn open(backend: Backend, key: &[u8]) -> io::Result<Box<dyn Transport>> {
+    #[cfg(all(
+        target_os = "linux",
+        target_pointer_width = "64",
+        target_endian = "little",
+        any(target_arch = "aarch64", target_arch = "x86_64")
+    ))]
+    {
+        linux::open(backend, key)
+    }
+    #[cfg(not(all(
+        target_os = "linux",
+        target_pointer_width = "64",
+        target_endian = "little",
+        any(target_arch = "aarch64", target_arch = "x86_64")
+    )))]
+    {
+        let _ = (backend, key);
+        Err(io::ErrorKind::Unsupported.into())
+    }
+}
+
+pub fn install() -> anyhow::Result<()> {
+    let backend = Backend::parse(&std::env::var("QUARK_EIP93").unwrap_or_default());
+    if backend == Backend::Off || !supported_device() {
+        return Ok(());
+    }
+    provider(Settings { backend, open })
+        .install_default()
+        .map_err(|_| {
+            anyhow::anyhow!("rustls provider was already installed before EIP93 initialization")
+        })
+}
+
+fn common(c: &CipherSuiteCommon) -> CipherSuiteCommon {
+    CipherSuiteCommon {
+        suite: c.suite,
+        hash_provider: c.hash_provider,
+        confidentiality_limit: c.confidentiality_limit,
+    }
+}
+
+// Called once in production. rustls requires static suite/algorithm references;
+// these six small allocations intentionally live for the process lifetime.
+fn provider(settings: Settings) -> CryptoProvider {
+    let mut p = rustls::crypto::ring::default_provider();
+    p.cipher_suites = p
+        .cipher_suites
+        .iter()
+        .map(|suite| {
+            let key_len = match suite.suite() {
+                CipherSuite::TLS13_AES_128_GCM_SHA256
+                | CipherSuite::TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
+                | CipherSuite::TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 => 16,
+                CipherSuite::TLS13_AES_256_GCM_SHA384
+                | CipherSuite::TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
+                | CipherSuite::TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 => 32,
+                _ => return *suite,
+            };
+            match suite {
+                SupportedCipherSuite::Tls13(s) => {
+                    SupportedCipherSuite::Tls13(Box::leak(Box::new(Tls13CipherSuite {
+                        common: common(&s.common),
+                        hkdf_provider: s.hkdf_provider,
+                        quic: s.quic,
+                        aead_alg: Box::leak(Box::new(Algorithm13 {
+                            inner: s.aead_alg,
+                            settings,
+                            key_len,
+                        })),
+                    })))
+                }
+                SupportedCipherSuite::Tls12(s) => {
+                    SupportedCipherSuite::Tls12(Box::leak(Box::new(Tls12CipherSuite {
+                        common: common(&s.common),
+                        prf_provider: s.prf_provider,
+                        kx: s.kx,
+                        sign: s.sign,
+                        aead_alg: Box::leak(Box::new(Algorithm12 {
+                            inner: s.aead_alg,
+                            settings,
+                        })),
+                    })))
+                }
+            }
+        })
+        .collect();
+    p
+}
+
+struct Algorithm13 {
+    inner: &'static dyn Tls13AeadAlgorithm,
+    settings: Settings,
+    key_len: usize,
+}
+impl Tls13AeadAlgorithm for Algorithm13 {
+    fn encrypter(&self, key: AeadKey, iv: Iv) -> Box<dyn MessageEncrypter> {
+        let state = State::new(key.as_ref(), self.settings);
+        let offset = Iv::from(<[u8; 12]>::try_from(iv.as_ref()).unwrap());
+        Box::new(Encrypt {
+            software: self.inner.encrypter(key, iv),
+            state,
+            iv: offset,
+            tls13: true,
+            plain: Zeroizing::new(Vec::new()),
+        })
+    }
+    fn decrypter(&self, key: AeadKey, iv: Iv) -> Box<dyn MessageDecrypter> {
+        let state = State::new(key.as_ref(), self.settings);
+        let offset = Iv::from(<[u8; 12]>::try_from(iv.as_ref()).unwrap());
+        Box::new(Decrypt {
+            software: self.inner.decrypter(key, iv),
+            state,
+            salt: offset,
+            tls13: true,
+        })
+    }
+    fn key_len(&self) -> usize {
+        self.key_len
+    }
+    fn extract_keys(
+        &self,
+        key: AeadKey,
+        iv: Iv,
+    ) -> Result<ConnectionTrafficSecrets, UnsupportedOperationError> {
+        self.inner.extract_keys(key, iv)
+    }
+}
+struct Algorithm12 {
+    inner: &'static dyn Tls12AeadAlgorithm,
+    settings: Settings,
+}
+impl Tls12AeadAlgorithm for Algorithm12 {
+    fn encrypter(&self, key: AeadKey, iv: &[u8], explicit: &[u8]) -> Box<dyn MessageEncrypter> {
+        let state = State::new(key.as_ref(), self.settings);
+        let mut offset = [0; 12];
+        offset[..4].copy_from_slice(iv);
+        offset[4..].copy_from_slice(explicit);
+        Box::new(Encrypt {
+            software: self.inner.encrypter(key, iv, explicit),
+            state,
+            iv: Iv::from(offset),
+            tls13: false,
+            plain: Zeroizing::new(Vec::new()),
+        })
+    }
+    fn decrypter(&self, key: AeadKey, iv: &[u8]) -> Box<dyn MessageDecrypter> {
+        let state = State::new(key.as_ref(), self.settings);
+        let mut salt = [0; 12];
+        salt[..4].copy_from_slice(iv);
+        Box::new(Decrypt {
+            software: self.inner.decrypter(key, iv),
+            state,
+            salt: Iv::from(salt),
+            tls13: false,
+        })
+    }
+    fn key_block_shape(&self) -> KeyBlockShape {
+        self.inner.key_block_shape()
+    }
+    fn extract_keys(
+        &self,
+        key: AeadKey,
+        iv: &[u8],
+        explicit: &[u8],
+    ) -> Result<ConnectionTrafficSecrets, UnsupportedOperationError> {
+        self.inner.extract_keys(key, iv, explicit)
+    }
+}
+
+struct Encrypt {
+    plain: Zeroizing<Vec<u8>>,
+    software: Box<dyn MessageEncrypter>,
+    state: State,
+    iv: Iv,
+    tls13: bool,
+}
+impl MessageEncrypter for Encrypt {
+    fn encrypt(
+        &mut self,
+        msg: OutboundPlainMessage<'_>,
+        seq: u64,
+    ) -> Result<OutboundOpaqueMessage, Error> {
+        let n = msg.payload.len() + usize::from(self.tls13);
+        if !self.state.eligible(n) {
+            return self.software.encrypt(msg, seq);
+        }
+        let nonce = Nonce::new(&self.iv, seq).0;
+        if self.plain.capacity() < MAX {
+            let additional = MAX - self.plain.len();
+            self.plain.reserve_exact(additional);
+        }
+        self.plain.clear();
+        msg.payload.copy_to_vec(&mut self.plain);
+        let mut aad = [0u8; 13];
+        let aad_len = if self.tls13 {
+            self.plain.push(msg.typ.into());
+            aad[..5].copy_from_slice(&make_tls13_aad(n + TAG));
+            5
+        } else {
+            aad.copy_from_slice(&make_tls12_aad(seq, msg.typ, msg.version, n));
+            13
+        };
+        let result = self
+            .state
+            .crypt_record(&nonce, &self.plain, &aad[..aad_len], false);
+        wipe(&mut self.plain);
+        self.plain.clear();
+        match result {
+            Some(Ok(out)) => {
+                let mut payload =
+                    PrefixedPayload::with_capacity(out.len() + if self.tls13 { 0 } else { 8 });
+                if !self.tls13 {
+                    payload.extend_from_slice(&nonce[4..]);
+                }
+                payload.extend_from_slice(&out);
+                Ok(OutboundOpaqueMessage::new(
+                    if self.tls13 {
+                        ContentType::ApplicationData
+                    } else {
+                        msg.typ
+                    },
+                    if self.tls13 {
+                        ProtocolVersion::TLSv1_2
+                    } else {
+                        msg.version
+                    },
+                    payload,
+                ))
+            }
+            Some(Err(_)) => Err(Error::EncryptError),
+            None => self.software.encrypt(msg, seq),
+        }
+    }
+    fn encrypted_payload_len(&self, n: usize) -> usize {
+        self.software.encrypted_payload_len(n)
+    }
+}
+struct Decrypt {
+    software: Box<dyn MessageDecrypter>,
+    state: State,
+    salt: Iv,
+    tls13: bool,
+}
+impl MessageDecrypter for Decrypt {
+    fn decrypt<'a>(
+        &mut self,
+        mut msg: InboundOpaqueMessage<'a>,
+        seq: u64,
+    ) -> Result<InboundPlainMessage<'a>, Error> {
+        let prefix = if self.tls13 { 0 } else { 8 };
+        let Some(n) = msg.payload.len().checked_sub(prefix + TAG) else {
+            return Err(Error::DecryptError);
+        };
+        if !self.state.eligible(n) {
+            return self.software.decrypt(msg, seq);
+        }
+        let mut nonce = Nonce::new(&self.salt, seq).0;
+        let mut aad = [0u8; 13];
+        let aad_len = if self.tls13 {
+            aad[..5].copy_from_slice(&make_tls13_aad(msg.payload.len()));
+            5
+        } else {
+            nonce[..4].copy_from_slice(&self.salt.as_ref()[..4]);
+            nonce[4..].copy_from_slice(&msg.payload[..8]);
+            aad.copy_from_slice(&make_tls12_aad(seq, msg.typ, msg.version, n));
+            13
+        };
+        match self
+            .state
+            .crypt_record(&nonce, &msg.payload[prefix..], &aad[..aad_len], true)
+        {
+            Some(Ok(plain)) => {
+                if !self.tls13 && plain.len() > 16384 {
+                    return Err(Error::PeerSentOversizedRecord);
+                }
+                msg.payload[..plain.len()].copy_from_slice(&plain);
+                msg.payload.truncate(plain.len());
+                if self.tls13 {
+                    msg.into_tls13_unpadded_message()
+                } else {
+                    Ok(msg.into_plain_message())
+                }
+            }
+            Some(Err(_)) => Err(Error::DecryptError),
+            None => self.software.decrypt(msg, seq),
+        }
+    }
+}
+
+static DEV_NOTICE: Once = Once::new();
+static AFALG_NOTICE: Once = Once::new();
+static FALLBACK_NOTICE: Once = Once::new();
+static SOFTWARE_NOTICE: Once = Once::new();
+struct State {
+    output: Zeroizing<Vec<u8>>,
+    key: Zeroizing<Vec<u8>>,
+    settings: Settings,
+    transport: Option<Box<dyn Transport>>,
+    dev_tried: bool,
+    disabled: bool,
+}
+impl State {
+    fn new(key: &[u8], settings: Settings) -> Self {
+        Self {
+            key: Zeroizing::new(key.to_vec()),
+            output: Zeroizing::new(Vec::new()),
+            settings,
+            transport: None,
+            dev_tried: false,
+            disabled: settings.backend == Backend::Off,
+        }
+    }
+    fn eligible(&self, n: usize) -> bool {
+        !self.disabled && (MIN..=MAX).contains(&n)
+    }
+    fn connect(&mut self) -> io::Result<()> {
+        if !self.dev_tried && self.settings.backend != Backend::Afalg {
+            self.dev_tried = true;
+            match self.verified(Backend::Devcrypto) {
+                Ok(t) => {
+                    DEV_NOTICE.call_once(|| tracing::info!("Quark EIP93: AES-GCM hybrid backend enabled (devcrypto CTR + CPU GHASH)"));
+                    self.transport = Some(t);
+                    return Ok(());
+                }
+                Err(e) if self.settings.backend == Backend::Devcrypto => return Err(e),
+                Err(e) => FALLBACK_NOTICE.call_once(|| tracing::warn!(error = %e, "Quark EIP93: devcrypto unavailable; trying AF_ALG")),
+            }
+        }
+        if self.settings.backend == Backend::Devcrypto {
+            return Err(io::ErrorKind::NotFound.into());
+        }
+        let t = self.verified(Backend::Afalg)?;
+        AFALG_NOTICE.call_once(|| {
+            tracing::info!("Quark EIP93: AES-GCM hybrid backend enabled (AF_ALG CTR + CPU GHASH)")
+        });
+        self.transport = Some(t);
+        self.settings.backend = Backend::Afalg;
+        Ok(())
+    }
+    fn verified(&self, backend: Backend) -> io::Result<Box<dyn Transport>> {
+        let mut t = (self.settings.open)(backend, &self.key)?;
+        selftest(t.as_mut(), &self.key)?;
+        Ok(t)
+    }
+    fn disable(&mut self, e: &io::Error) {
+        self.transport = None;
+        self.disabled = true;
+        self.key.zeroize();
+        SOFTWARE_NOTICE.call_once(
+            || tracing::warn!(error = %e, "Quark EIP93: backend unavailable; using ring software"),
+        );
+    }
+    // None means software fallback, Some(Err) means an authentication failure.
+    fn crypt_record(
+        &mut self,
+        nonce: &[u8; 12],
+        src: &[u8],
+        aad: &[u8],
+        decrypt: bool,
+    ) -> Option<io::Result<Record<'_>>> {
+        let n = if decrypt {
+            src.len().checked_sub(TAG)?
+        } else {
+            src.len()
+        };
+        if !self.eligible(n) || aad.len() > 256 {
+            return None;
+        }
+        let expected = if decrypt { n } else { n + TAG };
+        if self.output.capacity() < MAX + TAG {
+            let additional = MAX + TAG - self.output.len();
+            self.output.reserve_exact(additional);
+        }
+        self.output.resize(expected, 0);
+        let written = loop {
+            if self.transport.is_none() {
+                if let Err(e) = self.connect() {
+                    self.disable(&e);
+                    return None;
+                }
+            }
+            let result = self.transport.as_mut().unwrap().exchange_into(
+                nonce,
+                src,
+                aad,
+                decrypt,
+                &mut self.output,
+            );
+            match result {
+                Ok(len) if len == expected => break len,
+                Err(e) if decrypt && e.raw_os_error() == Some(libc::EBADMSG) => {
+                    wipe(&mut self.output);
+                    return Some(Err(e));
+                }
+                other => {
+                    let e = other
+                        .err()
+                        .unwrap_or_else(|| io::Error::other("wrong EIP93 output length"));
+                    self.transport = None;
+                    wipe(&mut self.output);
+                    if self.settings.backend != Backend::Auto || !self.dev_tried {
+                        self.disable(&e);
+                        return None;
+                    }
+                    // Auto may fail over from devcrypto only once. An AF_ALG failure
+                    // permanently disables this key, avoiding a reconnect loop.
+                    self.settings.backend = Backend::Afalg;
+                    FALLBACK_NOTICE.call_once(|| tracing::warn!(error = %e, "Quark EIP93: devcrypto failed; trying AF_ALG"));
+                }
+            }
+        };
+        Some(Ok(Record(&mut self.output[..written])))
+    }
+    #[cfg(test)]
+    fn crypt(
+        &mut self,
+        nonce: &[u8; 12],
+        src: &[u8],
+        aad: &[u8],
+        decrypt: bool,
+    ) -> Option<io::Result<Zeroizing<Vec<u8>>>> {
+        self.crypt_record(nonce, src, aad, decrypt)
+            .map(|r| r.map(|record| Zeroizing::new(record.to_vec())))
+    }
+}
+
+fn ring_key(key: &[u8]) -> aead::LessSafeKey {
+    let algorithm = if key.len() == 16 {
+        &aead::AES_128_GCM
+    } else {
+        &aead::AES_256_GCM
+    };
+    aead::LessSafeKey::new(aead::UnboundKey::new(algorithm, key).unwrap())
+}
+fn selftest(t: &mut dyn Transport, key: &[u8]) -> io::Result<()> {
+    let failed = || io::Error::other("EIP93 per-session verification failed");
+    let mut nonce = [0; 12];
+    SystemRandom::new().fill(&mut nonce).map_err(|_| failed())?;
+    let plain = Zeroizing::new((0..MIN).map(|i| (i * 7) as u8).collect::<Vec<_>>());
+    let aad = b"EIP93 selftest";
+    let mut expected = Zeroizing::new(plain.to_vec());
+    ring_key(key)
+        .seal_in_place_append_tag(
+            aead::Nonce::assume_unique_for_key(nonce),
+            aead::Aad::from(aad),
+            &mut *expected,
+        )
+        .map_err(|_| failed())?;
+    let mut actual = Zeroizing::new(vec![0; MIN + TAG]);
+    let n = t.exchange_into(&nonce, &plain, aad, false, &mut actual)?;
+    if n != expected.len() || actual[..n] != expected[..] {
+        return Err(failed());
+    }
+    let n = t.exchange_into(&nonce, &expected, aad, true, &mut actual)?;
+    if n != plain.len() || actual[..n] != plain[..] {
+        return Err(failed());
+    }
+    expected[MIN] ^= 1;
+    actual.fill(0xa5);
+    match t.exchange_into(&nonce, &expected, aad, true, &mut actual) {
+        Err(e) if e.raw_os_error() == Some(libc::EBADMSG) && actual.iter().all(|b| *b == 0xa5) => {
+            Ok(())
+        }
+        _ => Err(failed()),
+    }
+}
