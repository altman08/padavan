+// Copyright 2026 The PonWrt Authors.
+// SPDX-License-Identifier: MIT
+use super::*;
+use std::{
+    io::{Read, Write},
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+};
+
+fn settings(open: Open) -> Settings {
+    Settings {
+        backend: Backend::Auto,
+        open,
+    }
+}
+fn unavailable(_: Backend, _: &[u8]) -> io::Result<Box<dyn Transport>> {
+    Err(io::Error::from_raw_os_error(libc::ENOENT))
+}
+pub(super) struct SoftwareTransport {
+    key: aead::LessSafeKey,
+    calls: Arc<AtomicUsize>,
+    fail: Option<i32>,
+}
+impl Transport for SoftwareTransport {
+    fn exchange_into(
+        &mut self,
+        nonce: &[u8; 12],
+        src: &[u8],
+        aad: &[u8],
+        decrypt: bool,
+        dst: &mut [u8],
+    ) -> io::Result<usize> {
+        self.calls.fetch_add(1, Ordering::Relaxed);
+        if let Some(errno) = self.fail {
+            return Err(io::Error::from_raw_os_error(errno));
+        }
+        let mut out = Zeroizing::new(src.to_vec());
+        let nonce = aead::Nonce::assume_unique_for_key(*nonce);
+        if decrypt {
+            let n = self
+                .key
+                .open_in_place(nonce, aead::Aad::from(aad), &mut out)
+                .map_err(|_| io::Error::from_raw_os_error(libc::EBADMSG))?
+                .len();
+            out[n..].zeroize();
+            out.truncate(n);
+        } else {
+            self.key
+                .seal_in_place_append_tag(nonce, aead::Aad::from(aad), &mut *out)
+                .map_err(|_| io::Error::other("ring seal"))?;
+        }
+        dst[..out.len()].copy_from_slice(&out);
+        Ok(out.len())
+    }
+}
+pub(super) fn software(key: &[u8]) -> SoftwareTransport {
+    SoftwareTransport {
+        key: ring_key(key),
+        calls: Arc::new(AtomicUsize::new(0)),
+        fail: None,
+    }
+}
+fn model_open(_: Backend, key: &[u8]) -> io::Result<Box<dyn Transport>> {
+    Ok(Box::new(software(key)))
+}
+
+#[test]
+fn device_and_policy_gates() {
+    for good in [
+        b"airoha,an7581\0".as_slice(),
+        b"nokia,xg-040g-md\0airoha,en7581\0",
+    ] {
+        assert!(compatible(good));
+    }
+    for bad in [
+        b"".as_slice(),
+        b"airoha,an7581",
+        b"vendor,an7581\0",
+        b"airoha,an75810\0",
+        b"airoha,an7581\0airoha,an7583\0",
+        b"airoha,en7583\0",
+    ] {
+        assert!(!compatible(bad));
+    }
+    for (input, want) in [
+        ("", Backend::Auto),
+        ("auto", Backend::Auto),
+        ("devcrypto", Backend::Devcrypto),
+        ("afalg", Backend::Afalg),
+        ("off", Backend::Off),
+        ("typo", Backend::Off),
+    ] {
+        assert_eq!(Backend::parse(input), want);
+    }
+    #[cfg(not(target_arch = "aarch64"))]
+    assert!(!supported_device());
+}
+
+#[test]
+fn per_session_verification_rejects_bad_cipher_and_bad_authentication() {
+    let mut good = software(&[17; 32]);
+    selftest(&mut good, &[17; 32]).unwrap();
+    assert_eq!(good.calls.load(Ordering::Relaxed), 3);
+    assert!(selftest(&mut software(&[18; 32]), &[17; 32]).is_err());
+    struct Forged;
+    impl Transport for Forged {
+        fn exchange_into(
+            &mut self,
+            _: &[u8; 12],
+            src: &[u8],
+            _: &[u8],
+            _: bool,
+            dst: &mut [u8],
+        ) -> io::Result<usize> {
+            dst[..src.len()].copy_from_slice(src);
+            Ok(src.len())
+        }
+    }
+    assert!(selftest(&mut Forged, &[17; 32]).is_err());
+    fn invalid(_: Backend, _: &[u8]) -> io::Result<Box<dyn Transport>> {
+        Ok(Box::new(Forged))
+    }
+    let mut state = State::new(&[17; 32], settings(invalid));
+    assert!(state.crypt(&[0; 12], &[0; MIN], b"aad", false).is_none());
+    assert!(state.disabled);
+    assert!(state.key.iter().all(|b| *b == 0));
+}
+
+#[test]
+fn boundaries_authentication_and_failure_fallback() {
+    let key = [29; 32];
+    let mut state = State::new(&key, settings(model_open));
+    let nonce = [19; 12];
+    for n in [0, 1, MIN - 1, MIN, MIN + 1, 16384, MAX, MAX + 1] {
+        let plain = vec![37; n];
+        let result = state.crypt(&nonce, &plain, b"aad", false);
+        if !(MIN..=MAX).contains(&n) {
+            assert!(result.is_none());
+            continue;
+        }
+        let out = result.unwrap().unwrap();
+        let back = state.crypt(&nonce, &out, b"aad", true).unwrap().unwrap();
+        assert_eq!(*back, plain);
+        for (bad_nonce, bad_aad, bad_tag) in [
+            (true, false, false),
+            (false, true, false),
+            (false, false, true),
+        ] {
+            let mut corrupt_nonce = nonce;
+            let mut corrupt = out.to_vec();
+            if bad_nonce {
+                corrupt_nonce[0] ^= 1;
+            }
+            if bad_tag {
+                *corrupt.last_mut().unwrap() ^= 1;
+            }
+            let result = state.crypt(
+                &corrupt_nonce,
+                &corrupt,
+                if bad_aad { b"bad" } else { b"aad" },
+                true,
+            );
+            assert!(result.unwrap().is_err());
+            assert!(!state.disabled);
+            assert!(state.transport.is_some());
+        }
+        assert_eq!(
+            *state.crypt(&nonce, &out, b"aad", true).unwrap().unwrap(),
+            plain
+        );
+    }
+    assert!(state.crypt(&nonce, &[0; MIN], &[0; 257], false).is_none());
+    let mut dead = software(&key);
+    dead.fail = Some(libc::EIO);
+    state.transport = Some(Box::new(dead));
+    state.dev_tried = true;
+    state.settings.backend = Backend::Auto;
+    // Runtime devcrypto failure switches auto to an independently verified AF_ALG backend.
+    assert!(
+        state
+            .crypt(&nonce, &[0; MIN], b"aad", false)
+            .unwrap()
+            .is_ok()
+    );
+    assert_eq!(state.settings.backend, Backend::Afalg);
+    let mut dead = software(&key);
+    dead.fail = Some(libc::EIO);
+    state.transport = Some(Box::new(dead));
+    assert!(state.crypt(&nonce, &[0; MIN], b"aad", false).is_none());
+    assert!(state.disabled);
+    // Explicit devcrypto never tries AF_ALG after an operational failure.
+    let mut state = State::new(
+        &key,
+        Settings {
+            backend: Backend::Devcrypto,
+            open: model_open,
+        },
+    );
+    let mut dead = software(&key);
+    dead.fail = Some(libc::EIO);
+    state.transport = Some(Box::new(dead));
+    assert!(state.crypt(&nonce, &[0; MIN], b"aad", false).is_none());
+    assert!(state.disabled);
+}
+
+#[test]
+fn shared_threshold_and_record_buffer_reuse() {
+    for backend in [Backend::Devcrypto, Backend::Afalg] {
+        for key in [vec![29; 16], vec![29; 32]] {
+            let mut state = State::new(
+                &key,
+                Settings {
+                    backend,
+                    open: model_open,
+                },
+            );
+            assert!(
+                state
+                    .crypt_record(&[0; 12], &[0; 8191], b"aad", false)
+                    .is_none()
+            );
+            assert!(state.transport.is_none());
+            assert_eq!(state.output.capacity(), 0);
+            let mut allocation = None;
+            for (seq, n) in [8192, 16384, MAX, 8193, 8192].into_iter().enumerate() {
+                let nonce = [seq as u8; 12];
+                let input = vec![37; n];
+                let encrypted = {
+                    let record = state
+                        .crypt_record(&nonce, &input, b"aad", false)
+                        .unwrap()
+                        .unwrap();
+                    record.to_vec()
+                };
+                let ptr = state.output.as_ptr();
+                assert_eq!(*allocation.get_or_insert(ptr), ptr);
+                assert!(state.output.iter().all(|b| *b == 0));
+                {
+                    let record = state
+                        .crypt_record(&nonce, &encrypted, b"aad", true)
+                        .unwrap()
+                        .unwrap();
+                    assert_eq!(&*record, &input);
+                }
+                assert_eq!(state.output.as_ptr(), ptr);
+                assert!(state.output.iter().all(|b| *b == 0));
+                let mut bad = encrypted.clone();
+                *bad.last_mut().unwrap() ^= 1;
+                assert!(matches!(
+                    state.crypt_record(&nonce, &bad, b"aad", true).unwrap(),
+                    Err(e) if e.raw_os_error() == Some(libc::EBADMSG)
+                ));
+                assert!(!state.disabled);
+                assert!(state.output.iter().all(|b| *b == 0));
+                assert_eq!(state.output.as_ptr(), ptr);
+                assert_eq!(input, vec![37; n]);
+            }
+        }
+    }
+}
+
+fn pem(pem: &str) -> Vec<u8> {
+    use base64::Engine;
+    let text: String = pem.lines().filter(|s| !s.starts_with("---")).collect();
+    base64::engine::general_purpose::STANDARD
+        .decode(text)
+        .unwrap()
+}
+fn pump(client: &mut rustls::ClientConnection, server: &mut rustls::ServerConnection) {
+    for _ in 0..16 {
+        let mut moved = false;
+        if client.wants_write() {
+            let mut data = Vec::new();
+            client.write_tls(&mut data).unwrap();
+            let mut input = &data[..];
+            while !input.is_empty() {
+                assert!(server.read_tls(&mut input).unwrap() > 0);
+                server.process_new_packets().unwrap();
+            }
+            moved = true;
+        }
+        if server.wants_write() {
+            let mut data = Vec::new();
+            server.write_tls(&mut data).unwrap();
+            let mut input = &data[..];
+            while !input.is_empty() {
+                assert!(client.read_tls(&mut input).unwrap() > 0);
+                client.process_new_packets().unwrap();
+            }
+            moved = true;
+        }
+        if !moved {
+            return;
+        }
+    }
+    panic!("TLS failed to converge");
+}
+static KERNEL_DATA_CALLS: AtomicUsize = AtomicUsize::new(0);
+static KERNEL_CALLS: AtomicUsize = AtomicUsize::new(0);
+struct CountKernel(Box<dyn Transport>);
+impl Transport for CountKernel {
+    fn exchange_into(
+        &mut self,
+        nonce: &[u8; 12],
+        src: &[u8],
+        aad: &[u8],
+        decrypt: bool,
+        dst: &mut [u8],
+    ) -> io::Result<usize> {
+        KERNEL_CALLS.fetch_add(1, Ordering::Relaxed);
+        let result = self.0.exchange_into(nonce, src, aad, decrypt, dst);
+        if result.is_ok() && src.len() > MIN + TAG {
+            KERNEL_DATA_CALLS.fetch_add(1, Ordering::Relaxed);
+        }
+        result
+    }
+}
+// Host tests explicitly request the generic kernel driver; production always
+// binds/validates EIP93. No environment variable can enable this test override.
+#[cfg(all(
+    target_os = "linux",
+    target_pointer_width = "64",
+    target_endian = "little",
+    any(target_arch = "aarch64", target_arch = "x86_64")
+))]
+fn generic_open(backend: Backend, key: &[u8]) -> io::Result<Box<dyn Transport>> {
+    Ok(Box::new(CountKernel(linux::open_generic(backend, key)?)))
+}
+fn interop(open: Open) {
+    for suite in rustls::crypto::ring::default_provider().cipher_suites {
+        if format!("{:?}", suite.suite()).contains("CHACHA20") {
+            continue;
+        }
+        let rsa = matches!(
+            suite.suite(),
+            CipherSuite::TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
+                | CipherSuite::TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
+        );
+        let (cert, key) = if rsa {
+            (
+                include_str!("testdata/rsa-cert.pem"),
+                include_str!("testdata/rsa-key.pem"),
+            )
+        } else {
+            (
+                include_str!("testdata/ec-cert.pem"),
+                include_str!("testdata/ec-key.pem"),
+            )
+        };
+        let cert = rustls::pki_types::CertificateDer::from(pem(cert));
+        for accelerated_client in [true, false] {
+            let mut accelerated = provider(settings(open));
+            accelerated
+                .cipher_suites
+                .retain(|s| s.suite() == suite.suite());
+            let mut standard = rustls::crypto::ring::default_provider();
+            standard
+                .cipher_suites
+                .retain(|s| s.suite() == suite.suite());
+            let (cp, sp) = if accelerated_client {
+                (accelerated, standard)
+            } else {
+                (standard, accelerated)
+            };
+            let mut roots = rustls::RootCertStore::empty();
+            roots.add(cert.clone()).unwrap();
+            let cc = rustls::ClientConfig::builder_with_provider(Arc::new(cp))
+                .with_protocol_versions(&[suite.version()])
+                .unwrap()
+                .with_root_certificates(roots)
+                .with_no_client_auth();
+            let sc = rustls::ServerConfig::builder_with_provider(Arc::new(sp))
+                .with_protocol_versions(&[suite.version()])
+                .unwrap()
+                .with_no_client_auth()
+                .with_single_cert(
+                    vec![cert.clone()],
+                    rustls::pki_types::PrivatePkcs8KeyDer::from(pem(key)).into(),
+                )
+                .unwrap();
+            let mut c =
+                rustls::ClientConnection::new(Arc::new(cc), "localhost".try_into().unwrap())
+                    .unwrap();
+            let mut s = rustls::ServerConnection::new(Arc::new(sc)).unwrap();
+            c.set_buffer_limit(None);
+            s.set_buffer_limit(None);
+            pump(&mut c, &mut s);
+            assert!(!c.is_handshaking() && !s.is_handshaking());
+            assert_eq!(c.negotiated_cipher_suite().unwrap().suite(), suite.suite());
+            // Mix software and kernel-sized records, multi-record payloads and
+            // sequence-number changes on both directions of the same connection.
+            for size in [
+                0, 1, 1024, 4095, 4096, 4097, 8190, 8191, 8192, 8193, 16384, 32769,
+            ] {
+                let input: Vec<u8> = (0..size).map(|i| (i * 31) as u8).collect();
+                c.writer().write_all(&input).unwrap();
+                pump(&mut c, &mut s);
+                let mut received = vec![0; size];
+                s.reader().read_exact(&mut received).unwrap();
+                assert_eq!(received, input, "upload {:?}", suite.suite());
+                s.writer().write_all(&input).unwrap();
+                pump(&mut c, &mut s);
+                c.reader().read_exact(&mut received).unwrap();
+                assert_eq!(received, input, "download {:?}", suite.suite());
+            }
+            if suite.version() == &rustls::version::TLS13 {
+                c.refresh_traffic_keys().unwrap();
+                pump(&mut c, &mut s);
+                let input = vec![89; 16384];
+                c.writer().write_all(&input).unwrap();
+                pump(&mut c, &mut s);
+                let mut received = vec![0; input.len()];
+                s.reader().read_exact(&mut received).unwrap();
+                assert_eq!(received, input);
+            }
+        }
+    }
+}
