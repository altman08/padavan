+#[test]
+#[ignore = "run on AN7581/EN7581 with working EIP93 and cryptodev/AF_ALG"]
+fn hardware_tls_interoperability() {
+    assert!(supported_device(), "requires AN7581 without CPU AES");
+    let backend = Backend::parse(&std::env::var("QUARK_EIP93").unwrap_or_default());
+    assert!(
+        matches!(backend, Backend::Devcrypto | Backend::Afalg),
+        "select QUARK_EIP93=devcrypto or afalg explicitly"
+    );
+    fn required_open(backend: Backend, key: &[u8]) -> io::Result<Box<dyn Transport>> {
+        let selected = Backend::parse(&std::env::var("QUARK_EIP93").unwrap());
+        if backend != selected {
+            return Err(io::ErrorKind::Unsupported.into());
+        }
+        // Panic makes unavailable hardware fail the test instead of software fallback.
+        Ok(Box::new(CountKernel(open(backend, key).unwrap())))
+    }
+    for key in [vec![7; 16], vec![7; 32]] {
+        let mut t = open(backend, &key).unwrap();
+        selftest(t.as_mut(), &key).unwrap();
+    }
+    let before = KERNEL_DATA_CALLS.load(Ordering::Relaxed);
+    interop(required_open);
+    assert!(KERNEL_DATA_CALLS.load(Ordering::Relaxed) > before + 50);
+}
