+// This tree's Linux 4.4 AEAD interface includes tag space in both directions.
+fn legacy_kernel(release: &str) -> io::Result<bool> {
+    let mut parts = release.trim().split('.');
+    let major: u32 = parts.next().and_then(|s| s.parse().ok()).ok_or(io::ErrorKind::InvalidData)?;
+    let minor: u32 = parts.next().and_then(|s| s.parse().ok()).ok_or(io::ErrorKind::InvalidData)?;
+    Ok(major == 4 && minor == 4)
+}
+fn buffer_lengths(src: usize, aad: usize, expected: usize, decrypt: bool, legacy: bool) -> (usize, usize) {
+    let input = aad + src + if legacy && !decrypt { TAG } else { 0 };
+    (input, if legacy { input } else { aad + expected })
+}
