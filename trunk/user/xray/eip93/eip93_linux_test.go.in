//go:build linux && ((mipsle && !purego) || eip93test)

package gcm

import (
	"bytes"
	"crypto/internal/fips140/aes"
	"encoding/binary"
	"sync"
	"syscall"
	"testing"
)

func TestEIP93DTGate(t *testing.T) {
	for _, tc := range []struct {
		dt   string
		want bool
	}{
		{"xiaomi,redmi-router-ac2100\x00mediatek,mt7621-soc\x00", true},
		{"mediatek,mt7621-soc\x00", true},
		{"airoha,an7581\x00", false}, {"mediatek,mt7620-soc\x00", false},
		{"mediatek,mt7621-soc", false}, {"", false},
		{"vendor,mt7621-soc\x00", false}, {"mediatek,mt7621-soc-extra\x00", false},
	} {
		if eip93Compatible([]byte(tc.dt)) != tc.want {
			t.Fatalf("gate %q", tc.dt)
		}
	}
}

func TestEIP93Hardware(t *testing.T) {
	if !eip93Enabled() {
		t.Skip("requires MT7621 with EIP93 backend enabled")
	}
	for _, keyLen := range []int{16, 24, 32} {
		key := make([]byte, keyLen)
		for i := range key {
			key[i] = byte(i + 1)
		}
		block, err := aes.New(key)
		if err != nil {
			t.Fatal(err)
		}
		g, err := New(block, 12, 16)
		if err != nil {
			t.Fatal(err)
		}
		if g.eip93 == nil {
			t.Fatal("backend not selected")
		}
		for _, n := range []int{0, 1, 15, 16, 17, 4095, 4096, 4097, 16384, 16385, 32768, 32769} {
			plain := make([]byte, n)
			for i := range plain {
				plain[i] = byte(i * 7)
			}
			nonce := make([]byte, 12)
			nonce[0] = byte(n)
			nonce[1] = byte(n >> 8)
			aad := []byte("authentication data")
			want := make([]byte, n+16)
			sealGeneric(want, g, nonce, plain, aad)
			got := g.Seal(nil, nonce, plain, aad)
			if !bytes.Equal(got, want) {
				t.Fatalf("seal key=%d n=%d", keyLen, n)
			}
			buf := append([]byte(nil), got...)
			out, err := g.Open(buf[:0], nonce, buf, aad)
			if err != nil || !bytes.Equal(out, plain) {
				t.Fatalf("inplace open key=%d n=%d err=%v", keyLen, n, err)
			}
			buf = make([]byte, n, n+16)
			copy(buf, plain)
			got = g.Seal(buf[:0], nonce, buf, aad)
			if !bytes.Equal(got, want) {
				t.Fatalf("inplace seal key=%d n=%d", keyLen, n)
			}
			got[len(got)-1] ^= 1
			out, err = g.Open(nil, nonce, got, aad)
			if err == nil || out != nil {
				t.Fatal("corrupt tag accepted")
			}
		}
		if g.eip93.fd < 0 || g.eip93.disabled {
			t.Fatal("hardware failed or fell back")
		}
		var wg sync.WaitGroup
		for worker := 0; worker < 8; worker++ {
			wg.Add(1)
			go func(id int) {
				defer wg.Done()
				for i := 0; i < 20; i++ {
					nonce := make([]byte, 12)
					nonce[0] = byte(id + 64)
					nonce[1] = byte(i)
					plain := bytes.Repeat([]byte{byte(id)}, 8192)
					got := g.Seal(nil, nonce, plain, nil)
					out, err := g.Open(nil, nonce, got, nil)
					if err != nil || !bytes.Equal(out, plain) {
						t.Error("concurrent roundtrip")
					}
				}
			}(worker)
		}
		wg.Wait()
		// A closed operation fd must cause a safe software fallback, without
		// returning partial plaintext or leaking the global socket reservation.
		syscall.Close(g.eip93.fd)
		g.eip93.fd = 1 << 30 // Invalid descriptor without risking reuse by another goroutine.
		plain := make([]byte, 8192)
		nonce := make([]byte, 12)
		want := make([]byte, len(plain)+16)
		sealGeneric(want, g, nonce, plain, nil)
		if got := g.Seal(nil, nonce, plain, nil); !bytes.Equal(got, want) || !g.eip93.disabled {
			t.Fatal("closed-fd fallback")
		}
		for _, nt := range [][2]int{{8, 16}, {12, 12}} {
			other, err := New(block, nt[0], nt[1])
			if err != nil || other.eip93 != nil {
				t.Fatal("nonstandard GCM must use software")
			}
		}
	}
	if n := eip93Sockets.Load(); n != 0 {
		t.Fatalf("socket reservations leaked: %d", n)
	}
}

func TestEIP93Lengths(t *testing.T) {
	for _, tc := range []struct {
		decrypt, legacy                 bool
		src, aad, input, output, result int
	}{
		{false, false, 37, 13, 50, 66, 53},
		{false, true, 37, 13, 66, 66, 53},
		{true, false, 53, 13, 66, 50, 37},
		{true, true, 53, 13, 66, 66, 37},
	} {
		in, out, result := eip93Lengths(tc.src, tc.aad, tc.decrypt, tc.legacy)
		if in != tc.input || out != tc.output || result != tc.result {
			t.Fatalf("ABI lengths: %+v got %d %d %d", tc, in, out, result)
		}
	}
}

// Run with -tags=purego,eip93test to exercise the MIPS generic GCM hooks on a host.
// Binding software GCM is confined to this test; application code always binds EIP93.
func TestEIP93AFALGSoftware(t *testing.T) {
	for _, keyLen := range []int{16, 24, 32} {
		key := make([]byte, keyLen)
		for i := range key {
			key[i] = byte(i + 1)
		}
		block, err := aes.New(key)
		if err != nil {
			t.Fatal(err)
		}
		g, err := New(block, 12, 16)
		if err != nil {
			t.Fatal(err)
		}
		s := &eip93State{fd: -1, keyLen: keyLen}
		schedule := aes.EncryptionKeySchedule(&g.cipher)
		if recoveredLen := (len(schedule)/4 - 7) * 4; recoveredLen != keyLen {
			t.Fatal("unexpected AES schedule length", recoveredLen)
		}
		for i := 0; i < keyLen/4; i++ {
			binary.BigEndian.PutUint32(s.key[4*i:], schedule[i])
		}
		if !bytes.Equal(s.key[:keyLen], key) {
			t.Fatal("generic AES key recovery failed")
		}
		if err := s.connectTo("gcm_base(ctr(aes-generic),ghash-generic)"); err != nil {
			t.Fatal(err)
		}
		if !s.selftest(g) {
			s.close()
			t.Fatal("software AF_ALG self-test failed")
		}
		g.eip93 = s
		for _, n := range []int{4095, 4096, 4097, 16384, 32768, 32769} {
			for _, aadLen := range []int{0, 13, 256, 257} {
				plain := bytes.Repeat([]byte{7}, n)
				nonce := make([]byte, 12)
				nonce[0] = byte(n)
				nonce[1] = byte(n >> 8)
				nonce[2] = byte(aadLen)
				nonce[3] = byte(aadLen >> 8)
				aad := bytes.Repeat([]byte{19}, aadLen)
				want := make([]byte, n+16)
				sealGeneric(want, g, nonce, plain, aad)
				got := g.Seal(nil, nonce, plain, aad)
				if !bytes.Equal(got, want) {
					s.close()
					t.Fatalf("seal key=%d n=%d aad=%d", keyLen, n, aadLen)
				}
				buf := append([]byte(nil), got...)
				out, err := g.Open(buf[:0], nonce, buf, aad)
				if err != nil || !bytes.Equal(out, plain) {
					s.close()
					t.Fatal("in-place open", err)
				}
				buf = append(make([]byte, 0, n+16), plain...)
				if got = g.Seal(buf[:0], nonce, buf, aad); !bytes.Equal(got, want) {
					s.close()
					t.Fatal("in-place seal")
				}
				got[len(got)-1] ^= 1
				if out, err = g.Open(nil, nonce, got, aad); err == nil || out != nil {
					s.close()
					t.Fatal("corrupted tag accepted")
				}
			}
		}
		var wg sync.WaitGroup
		for id := 0; id < 4; id++ {
			wg.Add(1)
			go func(id int) {
				defer wg.Done()
				for i := 0; i < 10; i++ {
					nonce := make([]byte, 12)
					nonce[0] = byte(id + 64)
					nonce[1] = byte(i)
					plain := bytes.Repeat([]byte{byte(id)}, 8192)
					got := g.Seal(nil, nonce, plain, nil)
					if out, err := g.Open(nil, nonce, got, nil); err != nil || !bytes.Equal(out, plain) {
						t.Error("concurrent roundtrip", err)
					}
				}
			}(id)
		}
		wg.Wait()
		syscall.Close(s.fd)
		s.fd = 1 << 30
		plain, nonce := make([]byte, 8192), make([]byte, 12)
		want := make([]byte, len(plain)+16)
		sealGeneric(want, g, nonce, plain, nil)
		if got := g.Seal(nil, nonce, plain, nil); !bytes.Equal(got, want) || !s.disabled {
			s.close()
			t.Fatal("closed-socket fallback")
		}
		s.close()
	}
	if n := eip93Sockets.Load(); n != 0 {
		t.Fatalf("socket reservations leaked: %d", n)
	}
}

func TestEIP93SocketBudget(t *testing.T) {
	before := eip93Sockets.Load()
	eip93Sockets.Store(eip93MaxSockets)
	defer eip93Sockets.Store(before)
	s := &eip93State{fd: -1}
	if err := s.connectTo("gcm_base(ctr(aes-generic),ghash-generic)"); err != syscall.EMFILE {
		s.close()
		t.Fatal("socket limit was not enforced", err)
	}
	if n := eip93Sockets.Load(); n != eip93MaxSockets {
		t.Fatal("failed connection leaked a reservation", n)
	}
}
