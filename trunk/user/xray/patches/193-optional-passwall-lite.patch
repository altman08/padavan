+	_ "github.com/xtls/xray-core/main/confloader/external"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestFullBuildKeepsFormats(t *testing.T) {
+	for format, input := range map[string]string{"yaml": "outbounds:\n - protocol: freedom\n", "toml": "[[outbounds]]\nprotocol = \"freedom\"\n"} {
+		t.Run(format, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config."+format)
+			if err := os.WriteFile(path, []byte(input), 0600); err != nil {
+				t.Fatal(err)
+			}
+			config, err := serial.BuildConfig([]*core.ConfigSource{{Name: path, Format: format}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(config.Outbound) != 1 {
+				t.Fatal("missing freedom outbound")
+			}
+		})
+	}
+}
