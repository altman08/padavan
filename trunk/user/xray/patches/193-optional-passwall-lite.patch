--- /dev/null
+++ b/tools/lite/smoke.py
@@ -0,0 +1,230 @@
+#!/usr/bin/env python3
+"""Local interoperability check: a lite client against a full REALITY/Vision server.
+
+No external VPS, network namespaces or firewall changes. Needs a Go toolchain (set GO to override go).
+Usage: python3 tools/lite/smoke.py /path/to/lite /path/to/full [qemu-aarch64-static]
+The optional emulator runs the lite binary; the full server remains native.
+"""
+import contextlib
+import copy
+import hashlib
+import json
+import os
+import socket
+import struct
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+
+
+def recv_exact(s, n):
+    out = b''
+    while len(out) < n:
+        part = s.recv(n - len(out))
+        if not part:
+            raise RuntimeError('unexpected EOF')
+        out += part
+    return out
+
+
+def free_port():
+    with contextlib.closing(socket.socket()) as s:
+        s.bind(('127.0.0.1', 0))
+        return s.getsockname()[1]
+
+
+def wait_port(port, proc):
+    for _ in range(100):
+        if proc.poll() is not None:
+            raise RuntimeError('Xray exited before opening port')
+        try:
+            with socket.create_connection(('127.0.0.1', port), .1):
+                return
+        except OSError:
+            time.sleep(.05)
+    raise RuntimeError('listener timeout')
+
+
+def serve_tcp(listener):
+    def connection(c):
+        try:
+            with contextlib.closing(c):
+                while True:
+                    data = c.recv(65536)
+                    if not data:
+                        return
+                    c.sendall(data)
+        except OSError:
+            pass
+    while True:
+        try:
+            c, _ = listener.accept()
+        except OSError:
+            return
+        threading.Thread(target=connection, args=(c,), daemon=True).start()
+
+
+def serve_udp(s):
+    while True:
+        try:
+            data, peer = s.recvfrom(65535)
+            s.sendto(data, peer)
+        except OSError:
+            return
+
+
+def socks(port, command, dest_port):
+    s = socket.create_connection(('127.0.0.1', port), 15)
+    s.sendall(b'\x05\x01\x00')
+    assert recv_exact(s, 2) == b'\x05\x00'
+    s.sendall(b'\x05' + bytes([command]) + b'\x00\x01' + socket.inet_aton('127.0.0.1') + struct.pack('!H', dest_port))
+    head = recv_exact(s, 4)
+    assert head[:3] == b'\x05\x00\x00', head
+    assert head[3] == 1, head
+    addr = socket.inet_ntoa(recv_exact(s, 4))
+    udp_port = struct.unpack('!H', recv_exact(s, 2))[0]
+    return s, (addr if addr != '0.0.0.0' else '127.0.0.1', udp_port)
+
+
+def main():
+    lite, full = map(os.path.abspath, sys.argv[1:3])
+    command = ([os.path.abspath(sys.argv[3])] if len(sys.argv) > 3 else []) + [lite]
+    fixture = os.path.join(os.path.dirname(__file__), '../../infra/conf/testdata/lite-passwall.json')
+    processes = []
+    listeners = []
+    with tempfile.TemporaryDirectory(prefix='xray-lite-smoke-') as tmp:
+        logs = []
+        try:
+            for _ in range(2):
+                s = socket.socket()
+                s.bind(('127.0.0.1', 0))
+                s.listen(32)
+                listeners.append(s)
+            udp = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+            udp.bind(('127.0.0.1', 0))
+            listeners.append(udp)
+            target, echo = listeners[:2]
+            tls_port = target.getsockname()[1]
+            target.close()
+            probe = os.path.join(tmp, 'tlsprobe')
+            subprocess.check_call([os.environ.get('GO', 'go'), 'build', '-o', probe, os.path.join(os.path.dirname(__file__), 'tlsprobe.go')])
+            tls_proc = subprocess.Popen([probe, 'server', str(tls_port)])
+            processes.append(tls_proc)
+            wait_port(tls_port, tls_proc)
+            threading.Thread(target=serve_tcp, args=(echo,), daemon=True).start()
+            threading.Thread(target=serve_udp, args=(udp,), daemon=True).start()
+            keys = subprocess.check_output([full, 'x25519']).decode()
+            private = keys.split('PrivateKey: ')[1].splitlines()[0]
+            public = keys.split('Password (PublicKey): ')[1].splitlines()[0]
+            server_port, socks_port, redir_port, reverse_port = free_port(), free_port(), free_port(), free_port()
+            with open(fixture, encoding='utf-8') as f:
+                client = json.load(f)
+            client['env'] = {}
+            client['inbounds'][0]['listen'] = '127.0.0.1'
+            client['inbounds'][0]['port'] = socks_port
+            for inbound in client['inbounds'][1:]:
+                inbound['listen'] = '127.0.0.1'
+                inbound['port'] = redir_port
+            node = client['outbounds'][0]
+            node['settings'].update(address='127.0.0.1', port=server_port)
+            node['streamSettings']['realitySettings'].update(publicKey=public, serverName='localhost')
+            server = {
+                'log': {'loglevel': 'error'},
+                'inbounds': [{'listen': '127.0.0.1', 'port': server_port, 'protocol': 'vless', 'settings': {'clients': [{'id': node['settings']['id'], 'flow': 'xtls-rprx-vision'}], 'decryption': 'none'}, 'streamSettings': {'network': 'raw', 'security': 'reality', 'realitySettings': {'target': '127.0.0.1:' + str(tls_port), 'serverNames': ['localhost'], 'privateKey': private, 'shortIds': ['abcd']}}}],
+                'outbounds': [{'protocol': 'freedom', 'settings': {'finalRules': [{'action': 'allow'}]}}]
+            }
+            # A separate reverse-only identity establishes a VLESS reverse bridge.
+            reverse_id = '22222222-2222-4222-8222-222222222222'
+            server['inbounds'][0]['settings']['clients'].append({'id': reverse_id, 'flow': 'xtls-rprx-vision', 'reverse': {'tag': 'reverse-portal'}})
+            server['inbounds'].append({'listen': '127.0.0.1', 'port': reverse_port, 'protocol': 'socks', 'tag': 'reverse-socks', 'settings': {'auth': 'noauth'}})
+            server['routing'] = {'rules': [{'inboundTag': ['reverse-socks'], 'outboundTag': 'reverse-portal'}]}
+            reverse_node = copy.deepcopy(node)
+            reverse_node['tag'] = 'reverse-bridge-out'
+            reverse_node['settings'].update(id=reverse_id, reverse={'tag': 'reverse-bridge'})
+            client['outbounds'].append(reverse_node)
+            client['routing']['rules'].insert(0, {'inboundTag': ['reverse-bridge'], 'outboundTag': 'direct'})
+            for label, cmd, config, port in [('server', [full], server, server_port), ('client', command, client, socks_port)]:
+                path = os.path.join(tmp, label + '.json')
+                with open(path, 'w') as f:
+                    json.dump(config, f)
+                subprocess.check_call(cmd + ['run', '-test', '-c', path], stdout=subprocess.DEVNULL)
+                log = open(os.path.join(tmp, label + '.log'), 'w+')
+                logs.append(log)
+                proc = subprocess.Popen(cmd + ['run', '-c', path], stdout=log, stderr=log)
+                processes.append(proc)
+                wait_port(port, proc)
+            payload = os.urandom(1024 * 1024)
+            # Send concurrently so this checks sustained bidirectional forwarding.
+            s, _ = socks(socks_port, 1, echo.getsockname()[1])
+            with contextlib.closing(s):
+                sender = threading.Thread(target=s.sendall, args=(payload,))
+                sender.start()
+                assert hashlib.sha256(recv_exact(s, len(payload))).digest() == hashlib.sha256(payload).digest()
+                sender.join(15)
+                assert not sender.is_alive()
+            print('PASS SOCKS TCP -> VLESS REALITY/Vision -> TCP echo (1 MiB SHA256)')
+            # TLS application traffic activates the Vision TLS parsing/direct-copy path.
+            subprocess.check_call([probe, 'client', str(socks_port), str(tls_port)])
+            print('PASS SOCKS TLS application -> REALITY/Vision -> TLS echo (1 MiB)')
+            control, relay = socks(socks_port, 3, 0)
+            with contextlib.closing(control), contextlib.closing(socket.socket(socket.AF_INET, socket.SOCK_DGRAM)) as u:
+                u.settimeout(15)
+                header = b'\x00\x00\x00\x01' + socket.inet_aton('127.0.0.1') + struct.pack('!H', udp.getsockname()[1])
+                for size in [1, 512, 1400, 4096]:
+                    packet = os.urandom(size)
+                    u.sendto(header + packet, relay)
+                    received, _ = u.recvfrom(65535)
+                    assert received[:10] == header and received[10:] == packet
+            print('PASS SOCKS UDP -> VLESS XUDP -> UDP echo (1/512/1400/4096 bytes)')
+            with socket.create_connection(('127.0.0.1', socks_port), 15) as c:
+                c.sendall(('CONNECT 127.0.0.1:%d HTTP/1.1\r\nHost: localhost\r\n\r\n' % echo.getsockname()[1]).encode())
+                response = b''
+                while not response.endswith(b'\r\n\r\n'):
+                    response += recv_exact(c, 1)
+                    assert len(response) < 8192
+                assert response.startswith(b'HTTP/1.1 200'), response
+                c.sendall(payload[:65536])
+                assert recv_exact(c, 65536) == payload[:65536]
+            print('PASS SOCKS HTTP CONNECT fallback -> REALITY/Vision -> echo (64 KiB)')
+            # Wait for the periodic reverse bridge to register at the server.
+            reverse_error = None
+            for _ in range(50):
+                try:
+                    c, _ = socks(reverse_port, 1, echo.getsockname()[1])
+                    with contextlib.closing(c):
+                        c.settimeout(1)
+                        c.sendall(payload[:65536])
+                        assert recv_exact(c, 65536) == payload[:65536]
+                    reverse_error = None
+                    break
+                except (OSError, RuntimeError, AssertionError) as exc:
+                    reverse_error = exc
+                    time.sleep(.1)
+            if reverse_error is not None:
+                raise RuntimeError('VLESS reverse forwarding failed: ' + str(reverse_error))
+            print('PASS server SOCKS -> VLESS reverse -> lite client direct -> echo (64 KiB)')
+            print('PASS TCP REDIRECT + UDP TPROXY listeners start with mark=255')
+        except Exception:
+            for log in logs:
+                log.flush()
+                log.seek(0)
+                sys.stderr.write(log.read())
+            raise
+        finally:
+            for proc in reversed(processes):
+                proc.terminate()
+                try:
+                    proc.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    proc.kill()
+                    proc.wait()
+            for s in listeners:
+                s.close()
+            for log in logs:
+                log.close()
+
+
+if __name__ == '__main__':
+    main()
