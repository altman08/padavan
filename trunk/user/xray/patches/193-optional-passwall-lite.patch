new file mode 100644
index 0000000..e028567
--- /dev/null
+++ b/infra/conf/transport_internet_lite.go
@@ -0,0 +1,106 @@
+//go:build xray_lite
+
+package conf
+
+import (
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/transport/internet"
+	"google.golang.org/protobuf/proto"
+	"strings"
+)
+
+type TransportProtocol string
+
+func (p TransportProtocol) Build() (string, error) {
+	switch strings.ToLower(string(p)) {
+	case "raw", "tcp":
+		return "tcp", nil
+	default:
+		return "", errors.New("transport excluded from xray_lite: ", p)
+	}
+}
+
+type StreamConfig struct {
+	Address             *Address           `json:"address"`
+	Port                uint16             `json:"port"`
+	Method              *TransportProtocol `json:"method"`
+	Network             *TransportProtocol `json:"network"`
+	Security            string             `json:"security"`
+	TLSSettings         *TLSConfig         `json:"tlsSettings"`
+	REALITYSettings     *REALITYConfig     `json:"realitySettings"`
+	RAWSettings         *TCPConfig         `json:"rawSettings"`
+	TCPSettings         *TCPConfig         `json:"tcpSettings"`
+	SocketSettings      *SocketConfig      `json:"sockopt"`
+	FinalMask           *unavailableConfig `json:"finalmask"`
+	XHTTPSettings       *unavailableConfig `json:"xhttpSettings"`
+	SplitHTTPSettings   *unavailableConfig `json:"splithttpSettings"`
+	KCPSettings         *unavailableConfig `json:"kcpSettings"`
+	GRPCSettings        *unavailableConfig `json:"grpcSettings"`
+	WSSettings          *unavailableConfig `json:"wsSettings"`
+	HTTPUPGRADESettings *unavailableConfig `json:"httpupgradeSettings"`
+	HysteriaSettings    *unavailableConfig `json:"hysteriaSettings"`
+	MASQUESettings      *unavailableConfig `json:"masqueSettings"`
+	XDRIVESettings      *unavailableConfig `json:"xdriveSettings"`
+}
+
+func (c *StreamConfig) Build() (*internet.StreamConfig, error) {
+	config := &internet.StreamConfig{Port: uint32(c.Port), ProtocolName: "tcp"}
+	if c.Address != nil {
+		config.Address = c.Address.Build()
+	}
+	if c.Method != nil {
+		c.Network = c.Method
+	}
+	if c.Network != nil {
+		name, err := c.Network.Build()
+		if err != nil {
+			return nil, err
+		}
+		config.ProtocolName = name
+	}
+	var security proto.Message
+	var err error
+	switch strings.ToLower(c.Security) {
+	case "", "none":
+	case "tls":
+		settings := c.TLSSettings
+		if settings == nil {
+			settings = &TLSConfig{}
+		}
+		security, err = settings.Build()
+	case "reality":
+		if c.REALITYSettings == nil {
+			return nil, errors.New("REALITY: empty realitySettings")
+		}
+		security, err = c.REALITYSettings.Build()
+	default:
+		return nil, errors.New("security excluded from xray_lite: ", c.Security)
+	}
+	if err != nil {
+		return nil, err
+	}
+	if security != nil {
+		tm := serial.ToTypedMessage(security)
+		config.SecuritySettings = append(config.SecuritySettings, tm)
+		config.SecurityType = tm.Type
+	}
+	if c.RAWSettings != nil {
+		c.TCPSettings = c.RAWSettings
+	}
+	if c.TCPSettings != nil {
+		ts, err := c.TCPSettings.Build()
+		if err != nil {
+			return nil, err
+		}
+		config.TransportSettings = append(config.TransportSettings, &internet.TransportConfig{ProtocolName: "tcp", Settings: serial.ToTypedMessage(ts)})
+	}
+	if c.SocketSettings != nil {
+		ss, err := c.SocketSettings.Build()
+		if err != nil {
+			return nil, err
+		}
+		config.SocketSettings = ss
+	}
+	return config, nil
+}
