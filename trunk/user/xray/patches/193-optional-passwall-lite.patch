+//go:build xray_lite
+
+package conf_test
+
+import (
+	"encoding/json"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/xtls/xray-core/app/proxyman"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/infra/conf"
+	_ "github.com/xtls/xray-core/main/distro/all"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+func TestLitePasswallConfig(t *testing.T) {
+	t.Setenv("XRAY_LOCATION_ASSET", "")
+	data, err := os.ReadFile("testdata/lite-passwall.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var c conf.Config
+	if err := json.Unmarshal(data, &c); err != nil {
+		t.Fatal(err)
+	}
+	built, err := c.Build()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(built.Inbound) != 3 || len(built.Outbound) != 3 {
+		t.Fatal("missing handlers")
+	}
+	for i, want := range []internet.SocketConfig_TProxyMode{internet.SocketConfig_Redirect, internet.SocketConfig_TProxy} {
+		receiver, err := built.Inbound[i+1].ReceiverSettings.GetInstance()
+		if err != nil {
+			t.Fatal(err)
+		}
+		r := receiver.(*proxyman.ReceiverConfig)
+		if !r.ReceiveOriginalDestination || r.StreamSettings.SocketSettings.Tproxy != want {
+			t.Fatalf("original destination/socket mode lost: %v", r)
+		}
+	}
+	sender, err := built.Outbound[0].SenderSettings.GetInstance()
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := sender.(*proxyman.SenderConfig)
+	if s.StreamSettings.ProtocolName != "tcp" || s.StreamSettings.SocketSettings.Mark != 255 || s.StreamSettings.SocketSettings.DomainStrategy != internet.DomainStrategy_USE_IP || !strings.HasSuffix(s.StreamSettings.SecurityType, "reality.Config") {
+		t.Fatalf("VLESS socket/transport settings lost: %v", s)
+	}
+	instance, err := core.New(built)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := instance.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if os.Getenv("XRAY_LOCATION_ASSET") != "/tmp/etc/passwall_tmp/geodata" {
+		t.Fatal("config env lost")
+	}
+}
+
+func TestLiteRejectsUnavailableFeatures(t *testing.T) {
+	for _, input := range []string{
+		`{"dns":{}}`, `{"api":{}}`, `{"fakeDns":[]}`, `{"metrics":{}}`, `{"geodata":{}}`,
+		`{"observatory":{}}`, `{"burstObservatory":{}}`, `{"reverse":{}}`,
+		`{"inbounds":[{"protocol":"vless","port":12345}]}`,
+		`{"outbounds":[{"protocol":"vmess"}]}`,
+		`{"outbounds":[{"protocol":"trojan"}]}`,
+		`{"outbounds":[{"protocol":"wireguard"}]}`,
+		`{"outbounds":[{"protocol":"freedom","streamSettings":{"method":"grpc"}}]}`,
+		`{"outbounds":[{"protocol":"freedom","streamSettings":{"method":"xhttp"}}]}`,
+		`{"outbounds":[{"protocol":"freedom","streamSettings":{"wsSettings":{}}}]}`,
+		`{"outbounds":[{"protocol":"freedom","streamSettings":{"finalmask":{}}}]}`,
+		`{"outbounds":[{"protocol":"freedom","streamSettings":{"security":"tls","tlsSettings":{"echConfigList":"https://example.com/dns-query"}}}]}`,
+	} {
+		t.Run(input, func(t *testing.T) {
+			var c conf.Config
+			if err := json.Unmarshal([]byte(input), &c); err != nil {
+				return
+			}
+			if _, err := c.Build(); err == nil {
+				t.Fatal("unavailable feature accepted")
+			}
+		})
+	}
+	// Security validation must survive moving the full distribution's validators.
+	var c conf.Config
+	input := `{"outbounds":[{"protocol":"vless","settings":{"address":"example.com","port":443,"id":"11111111-1111-4111-8111-111111111111","encryption":"none"}}]}`
+	if err := json.Unmarshal([]byte(input), &c); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.Build(); err == nil || !strings.Contains(err.Error(), "without TLS") {
+		t.Fatalf("insecure public VLESS accepted: %v", err)
+	}
+}
