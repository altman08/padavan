@@ -0,0 +1,97 @@
+// A local TLS 1.3 echo endpoint and SOCKS TLS client for smoke.py.
+package main
+
+import (
+	"bytes"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"fmt"
+	"io"
+	"math/big"
+	"net"
+	"os"
+	"strconv"
+	"time"
+)
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+func run() error {
+	if os.Args[1] == "server" {
+		key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+		if err != nil {
+			return err
+		}
+		cert := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "localhost"}, DNSNames: []string{"localhost"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+		der, err := x509.CreateCertificate(rand.Reader, cert, cert, &key.PublicKey, key)
+		if err != nil {
+			return err
+		}
+		l, err := tls.Listen("tcp", "127.0.0.1:"+os.Args[2], &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}}, MinVersion: tls.VersionTLS13, MaxVersion: tls.VersionTLS13, CurvePreferences: []tls.CurveID{tls.X25519}, NextProtos: []string{"h2", "http/1.1"}})
+		if err != nil {
+			return err
+		}
+		defer l.Close()
+		for {
+			c, err := l.Accept()
+			if err != nil {
+				return err
+			}
+			go func() { defer c.Close(); io.Copy(c, c) }()
+		}
+	}
+	c, err := net.DialTimeout("tcp", "127.0.0.1:"+os.Args[2], 10*time.Second)
+	if err != nil {
+		return err
+	}
+	defer c.Close()
+	c.SetDeadline(time.Now().Add(20 * time.Second))
+	c.Write([]byte{5, 1, 0})
+	reply := make([]byte, 2)
+	if _, err = io.ReadFull(c, reply); err != nil {
+		return err
+	}
+	if !bytes.Equal(reply, []byte{5, 0}) {
+		return fmt.Errorf("SOCKS greeting: %x", reply)
+	}
+	port, err := strconv.Atoi(os.Args[3])
+	if err != nil {
+		return err
+	}
+	c.Write([]byte{5, 1, 0, 1, 127, 0, 0, 1, byte(port >> 8), byte(port)})
+	reply = make([]byte, 10)
+	if _, err = io.ReadFull(c, reply); err != nil {
+		return err
+	}
+	if reply[1] != 0 {
+		return fmt.Errorf("SOCKS connect: %x", reply)
+	}
+	// This certificate belongs to the local, ephemeral test endpoint only.
+	t := tls.Client(c, &tls.Config{ServerName: "localhost", InsecureSkipVerify: true, MinVersion: tls.VersionTLS13, MaxVersion: tls.VersionTLS13})
+	if err = t.Handshake(); err != nil {
+		return err
+	}
+	payload := make([]byte, 1024*1024)
+	rand.Read(payload)
+	sent := make(chan error, 1)
+	go func() { _, err := t.Write(payload); sent <- err }()
+	received := make([]byte, len(payload))
+	if _, err = io.ReadFull(t, received); err != nil {
+		return err
+	}
+	if err = <-sent; err != nil {
+		return err
+	}
+	if !bytes.Equal(received, payload) {
+		return fmt.Errorf("TLS echo mismatch")
+	}
+	return nil
+}
