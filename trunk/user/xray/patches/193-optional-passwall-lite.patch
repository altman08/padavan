+//go:build xray_lite
+
+package conf
+
+import (
+	"github.com/xtls/xray-core/app/proxyman"
+	"github.com/xtls/xray-core/common/errors"
+	"google.golang.org/protobuf/proto"
+)
+
+// Keep fields visible to JSON decoding so an unavailable feature is rejected,
+// rather than silently discarded by encoding/json.
+type unavailableConfig struct{}
+
+func (*unavailableConfig) UnmarshalJSON([]byte) error {
+	return errors.New("feature excluded from xray_lite; use the full Xray build")
+}
+func (*unavailableConfig) Build() (proto.Message, error) {
+	return nil, errors.New("feature excluded from xray_lite; use the full Xray build")
+}
+
+type APIConfig = unavailableConfig
+type DNSConfig = unavailableConfig
+type FakeDNSConfig = unavailableConfig
+type GeodataConfig = unavailableConfig
+type MetricsConfig = unavailableConfig
+type ObservatoryConfig = unavailableConfig
+type BurstObservatoryConfig = unavailableConfig
+type ReverseConfig = unavailableConfig
+
+var (
+	inboundConfigLoader = NewJSONConfigLoader(ConfigCreatorCache{
+		"tunnel":        func() interface{} { return new(DokodemoConfig) },
+		"dokodemo-door": func() interface{} { return new(DokodemoConfig) },
+		"socks":         func() interface{} { return new(SocksServerConfig) },
+	}, "protocol", "settings")
+	outboundConfigLoader = NewJSONConfigLoader(ConfigCreatorCache{
+		"block":     func() interface{} { return new(BlackholeConfig) },
+		"blackhole": func() interface{} { return new(BlackholeConfig) },
+		"direct":    func() interface{} { return new(FreedomConfig) },
+		"freedom":   func() interface{} { return new(FreedomConfig) },
+		"vless":     func() interface{} { return new(VLessOutboundConfig) },
+	}, "protocol", "settings")
+)
+
+func validateOutboundTransportSecurity(rawConfig interface{}, senderSettings *proxyman.SenderConfig) error {
+	if senderSettings.StreamSettings != nil && senderSettings.StreamSettings.GetSecurityType() != "" {
+		return nil
+	}
+	if c, ok := rawConfig.(*VLessOutboundConfig); ok {
+		if c.Encryption != "" && c.Encryption != "none" {
+			return nil
+		}
+		if requiresTransportSecurity(c.Address) {
+			return errors.New("vless without TLS or other encryption is prohibited unless the server address is a private IP or domain")
+		}
+	}
+	return nil
+}
+
+func validateInboundTransport(proto.Message, *proxyman.ReceiverConfig) error { return nil }
+func validateOutboundTransport(proto.Message, *proxyman.SenderConfig) error  { return nil }
+
+func validateTLSFeatures(c *TLSConfig) error {
+	if c.ECHServerKeys != "" || c.ECHConfigList != "" || c.ECHSocketSettings != nil {
+		return errors.New("ECH excluded from xray_lite")
+	}
+	return nil
+}
